[Unit]
Description=Discord Life Bot
After=network.target

[Service]
# === CUSTOMIZE THESE ===
User=deploy
WorkingDirectory=/home/deploy/discord-life-bot
ExecStart=/home/deploy/discord-life-bot/venv/bin/python bot.py
EnvironmentFile=/home/deploy/discord-life-bot/.env
# ========================

Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/deploy/discord-life-bot

[Install]
WantedBy=multi-user.target
