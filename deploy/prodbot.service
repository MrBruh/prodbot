[Unit]
Description=Prodbot
After=network.target

[Service]
User=prodbot
WorkingDirectory=/srv/prodbot
ExecStart=/srv/prodbot/venv/bin/python bot.py
EnvironmentFile=/etc/prodbot.env

Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prodbot

[Install]
WantedBy=multi-user.target
