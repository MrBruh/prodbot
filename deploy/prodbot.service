[Unit]
Description=Prodbot
After=network.target

[Service]
# === CUSTOMIZE THESE ===
User=deploy
WorkingDirectory=/home/deploy/prodbot
ExecStart=/home/deploy/prodbot/venv/bin/python bot.py
EnvironmentFile=/home/deploy/prodbot/.env
# ========================

Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/deploy/prodbot

[Install]
WantedBy=multi-user.target
